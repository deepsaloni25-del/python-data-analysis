    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "subjects = [\"Python\", \"Maths\", \"AI\"]\n",
        "averages = [\n",
        "    df[\"Python\"].mean(),\n",
        "    df[\"Maths\"].mean(),\n",
        "    df[\"AI\"].mean()\n",
        "]\n",
        "\n",
        "plt.bar(subjects, averages)\n",
        "plt.title(\"Average Marks by Subject\")\n",
        "plt.xlabel(\"Subjects\")\n",
        "plt.ylabel(\"Average Marks\")\n",
