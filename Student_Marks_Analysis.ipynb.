    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    \"Name\": [\"Aman\", \"Priya\", \"Rahul\", \"Simran\", \"Neha\"],\n",
        "    \"Python\": [85, 90, 65, 78, 95],\n",
        "    \"Maths\": [80, 92, 70, 75, 88],\n",
        "    \"AI\": [90, 95, 60, 82, 93]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(df)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2uaw454aIDrt",
        "outputId": "6abca1ee-455a-4aed-c39f-04358333430a"
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
