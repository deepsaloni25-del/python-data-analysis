          "text": [
            "     Name  Python  Maths  AI\n",
            "0    Aman      85     80  90\n",
            "1   Priya      90     92  95\n",
            "2   Rahul      65     70  60\n",
            "3  Simran      78     75  82\n",
            "4    Neha      95     88  93\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "df[\"Total\"] = df[\"Python\"] + df[\"Maths\"] + df[\"AI\"]\n",
        "\n",
        "df[\"Percentage\"] = (df[\"Total\"] / 300) * 100\n",
        "\n",
        "print(df)\n",
        "\n",
        "print(\"\\nClass Average:\")\n",
        "print(df[\"Percentage\"].mean())\n",
        "\n",
        "print(\"\\nClass Topper:\")\n",
        "print(df.loc[df[\"Total\"].idxmax(), \"Name\"])"
      ],
